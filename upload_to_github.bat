@echo off
chcp 65001 > nul
echo ========================================================
echo        جاري تهيئة المستودع ورفع الملفات إلى GitHub
echo ========================================================
echo.

:: الانتقال لمجلد السكربت الحالي
cd /d "%~dp0"

:: تهيئة وإضافة الملفات
git init
git add .
git commit -m "إطلاق استمارة موكب كلية الإمام الكاظم"

:: ضبط الفرع والرابط عن بعد
git branch -M main
git remote remove origin >nul 2>&1
git remote add origin https://github.com/HARH-cmd/ikc-procession.git

echo.
echo ========================================================
echo   جاري الرفع... سيطلب منك النظام الآن تسجيل الدخول إلى GitHub
echo ========================================================
echo.

git push -u origin main

echo.
echo ========================================================
echo        تمت العملية بنجاح! يمكنك إغلاق النافذة الآن.
echo ========================================================
pause
